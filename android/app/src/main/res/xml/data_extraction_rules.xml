<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules. See backup_rules.xml for the rationale. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="credentials.xml" />
    </device-transfer>
</data-extraction-rules>
