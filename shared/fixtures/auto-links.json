{
  "about": "Auto-link fixtures shared by the Swift (SeanboyCore) and Kotlin (:core) AutoLinks ports (PRD editor v4, core feature 5). Text that matches another note's title, as a whole word and ignoring case, is an auto-link: display-only, never written to the file. `titles` are the notes that exist; `current` is the open note (never linked to itself). Each expected link gives the matched `text` and the `title` it opens; `start` (UTF-16 offset) is checked when present. Links are listed by position. Rules: the longest title wins where titles overlap; matches never overlap; titles shorter than 3 characters are ignored; nothing inside code, code blocks, wiki links, links, or URLs is matched.",
  "cases": [
    { "name": "exact title", "titles": ["Recipes"], "input": "see Recipes today",
      "links": [ { "text": "Recipes", "title": "Recipes", "start": 4 } ] },
    { "name": "case-insensitive, opens the real title", "titles": ["Kitchen Floor"], "input": "the kitchen floor tiles",
      "links": [ { "text": "kitchen floor", "title": "Kitchen Floor" } ] },
    { "name": "whole words only", "titles": ["Plan"], "input": "Planning a plane, Plan B, plan.",
      "links": [ { "text": "Plan", "title": "Plan", "start": 18 }, { "text": "plan", "title": "Plan", "start": 26 } ] },
    { "name": "unicode letters are word characters", "titles": ["café"], "input": "cafés and café",
      "links": [ { "text": "café", "title": "café", "start": 10 } ] },
    { "name": "longest title wins", "titles": ["House", "House Stuff", "Stuff"], "input": "House Stuff list",
      "links": [ { "text": "House Stuff", "title": "House Stuff" } ] },
    { "name": "matches never overlap", "titles": ["New York", "York City"], "input": "New York City",
      "links": [ { "text": "New York", "title": "New York" } ] },
    { "name": "never the current note", "titles": ["Ideas", "Journal"], "current": "Ideas", "input": "Ideas for the Journal",
      "links": [ { "text": "Journal", "title": "Journal" } ] },
    { "name": "short titles are ignored", "titles": ["Go", "A"], "input": "Go get A thing", "links": [] },
    { "name": "regex characters in titles are literal", "titles": ["C++ (notes)", "a.b"], "input": "C++ (notes) and axb and a.b",
      "links": [ { "text": "C++ (notes)", "title": "C++ (notes)" }, { "text": "a.b", "title": "a.b" } ] },
    { "name": "titles ending in punctuation still need a boundary before", "titles": ["Theme Park Pulse_ 1"], "input": "see Theme Park Pulse_ 1 now",
      "links": [ { "text": "Theme Park Pulse_ 1", "title": "Theme Park Pulse_ 1" } ] },
    { "name": "not inside code, links, wiki links, or urls", "titles": ["Recipes"],
      "input": "`Recipes` [[Recipes]] [Recipes](https://x.com/Recipes) https://x.com/Recipes and Recipes",
      "links": [ { "text": "Recipes", "title": "Recipes", "start": 81 } ] },
    { "name": "not inside a code block", "titles": ["Recipes"], "input": "```\nRecipes\n```\nRecipes",
      "links": [ { "text": "Recipes", "title": "Recipes", "start": 16 } ] },
    { "name": "inside emphasis and headings is fine", "titles": ["Recipes"], "input": "# My Recipes\n**Recipes**",
      "links": [ { "text": "Recipes", "title": "Recipes", "start": 5 }, { "text": "Recipes", "title": "Recipes", "start": 15 } ] },
    { "name": "no titles, no links", "titles": [], "input": "anything", "links": [] },
    { "name": "offsets are UTF-16", "titles": ["Party"], "input": "🎉 Party",
      "links": [ { "text": "Party", "title": "Party", "start": 3 } ] }
  ]
}
